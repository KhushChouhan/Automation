{
  "name": "@gcs/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file=../../.env --env-file-if-exists=../../.env.local --import tsx --watch src/main.ts",
    "start": "node --env-file=../../.env --env-file-if-exists=../../.env.local dist/main.js",
    "google:smoke": "node --env-file=../../.env --env-file-if-exists=../../.env.local --import tsx src/google-live-smoke.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@gcs/config": "workspace:*",
    "@gcs/core": "workspace:*",
    "@gcs/database": "workspace:*",
    "@gcs/integrations": "workspace:*",
    "@gcs/observability": "workspace:*",
    "bullmq": "^5.41.9",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  }
}
