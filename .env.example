# Local development defaults. Production uses managed PostgreSQL and Redis 7/8.
NODE_ENV=development
PROCESS_ROLE=api
PORT=8000
API_BASE_URL=http://127.0.0.1:8000
# Server-only: use the same high-entropy token in API and admin secret stores.
ADMIN_API_TOKEN=
# Browser access boundary, independent of the private API token.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
# Optional immutable source revision; providers supply RENDER_GIT_COMMIT/RAILWAY_GIT_COMMIT_SHA.
APP_REVISION=
APP_TIMEZONE=Asia/Kolkata
DAILY_REEL_LIMIT=2
SAME_FACE_GAP_DAYS=2
SLOT_1=19:00
SLOT_2=20:00
SCHEDULING_HORIZON_DAYS=90
AUTOMATION_ENABLED=false
INSTAGRAM_PUBLISHING_ENABLED=false
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/reels_automation
# Compose maps Redis 7 to 6380 to avoid the legacy Redis 3 service on 6379.
REDIS_URL=redis://127.0.0.1:6380
# Destructive integration tests require an explicitly isolated test database.
TEST_DATABASE_URL=

# Optional integrations: leave blank until authorized; never use fake secrets.
GOOGLE_AUTH_TYPE=oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEET_ID=
GOOGLE_AUTOMATION_ROOT_FOLDER_ID=
GOOGLE_VIDEO_FOLDER_ID=
GOOGLE_THUMBNAIL_FOLDER_ID=
GOOGLE_ARCHIVE_FOLDER_ID=
GOOGLE_DRIVE_ARCHIVE_ENABLED=false
GOOGLE_SYNC_INTERVAL_MINUTES=5
CONTENT_GENERATOR_PROVIDER=gemini
GEMINI_API_KEY=
# Set an account-supported model explicitly before enabling generation.
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
MEDIA_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
META_AUTH_PATH=facebook_login
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=
