# Application Configuration
NODE_ENV=production
APP_TIMEZONE=Asia/Kolkata
DAILY_REEL_LIMIT=2
SAME_FACE_GAP_DAYS=2
SLOT_1=19:00
SLOT_2=20:00
AUTOMATION_ENABLED=false
LOG_LEVEL=info

# Database & Redis
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reels_automation
REDIS_URL=redis://127.0.0.1:6379

# Google Workspace / Drive / Sheets
GOOGLE_AUTH_TYPE=oauth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_AUTOMATION_ROOT_FOLDER_ID=your_root_folder_id
GOOGLE_VIDEO_FOLDER_ID=your_video_folder_id
GOOGLE_THUMBNAIL_FOLDER_ID=your_thumbnail_folder_id
GOOGLE_ARCHIVE_FOLDER_ID=your_archive_folder_id
GOOGLE_DRIVE_ARCHIVE_ENABLED=false
GOOGLE_SYNC_INTERVAL_MINUTES=5

# AI Content Generation (gemini or openai)
CONTENT_GENERATOR_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Media Storage (cloudinary, r2, or local)
MEDIA_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Meta / Instagram Graph API
META_AUTH_PATH=facebook_login
META_PAGE_ACCESS_TOKEN=your_extended_page_access_token
META_PAGE_ID=your_facebook_page_id
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id
INSTAGRAM_PUBLISHING_ENABLED=false
